# Copy to .env.streamershub. These override the shared .env (the school systems' file) for Streamers Hub only.

ENVIRONMENT=development                 # production on the server
# SH_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/streamers_hub
#   If unset, the school's Postgres server is used with the database name "streamers_hub" (created on first start).
# SH_FROM_EMAIL=Streamers Hub <no-reply@streamershubmedia.com>   # must be a verified SES identity
# SH_EMAIL_MODE=ses                      # "log" for offline development: nothing is sent
# SH_YOUTUBE_API_KEY=AIza...             # YouTube Data API v3 key: reads YouTube Shorts view counts for clip checks. Optional.
# SH_PAYSTACK_SECRET_KEY=sk_live_...     # Streamers Hub's own Paystack account. Without it, test payments only (never in production).
# SH_FRONTEND_URL=https://streamershubmedia.com
# SH_COOKIE_DOMAIN=.streamershubmedia.com
# SH_PROXY_HOPS=1                        # behind one load balancer
# SH_S3_PREFIX=streamers-hub             # key prefix in the shared bucket
# SH_DATA_KEY=...                        # key for personal data at rest; defaults to one derived from SECRET_KEY
